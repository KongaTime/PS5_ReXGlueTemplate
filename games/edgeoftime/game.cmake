# Spider-Man: Edge of Time - the game, as the template builds it (the worked example).
#
#   GAME=games/edgeoftime tools/build.sh
#
# Builds EdgeOfTimeRecomp (../EdgeOfTimeRecomp, or EDGEOFTIMERECOMP_SRC: the PC
# recompilation, KongaTime's fork with the PS5 branches) for the title, as its
# desktop build does (its CMakeLists.txt), from:
#
#   - the game's recompiled code, which `rexglue codegen reeot_manifest.toml` writes
#     to its generated/default (Default.xex) and generated/gamelogic (GameLogic.dll)
#     from your own game files: eot_recomp, and eot_gamelogic, which the PC build
#     opens as a shared library and the title links in (module_static.cpp);
#   - the repository's sources for the PS5 (its ps5/reeot-sources.cmake): eot_game;
#   - its renderer, plume (its thirdparty/plume, with ps5/patches/plume-ps5.patch
#     applied): eot_plume, using the title's volk (PLUME_NO_VOLK_IMPLEMENTATION);
#   - zstd (its XenosRecomp's): eot_zstd. xxHash is the runtime's.
#
# The game draws with its own renderer and recompiled shaders, not ReXGlue's
# emulated GPU. Its recompiled shaders (generated/shader_cache_ps5.cpp, with
# shader-cache.zst beside eboot.bin) are used when they are there; without them,
# the first launch finds the game's shaders and writes them for recompiling
# (EdgeOfTimeRecomp's RELEASE steps). The port's packages come from the game
# folder copied from a PC install, so none are embedded.
#
# Needs dxc (DirectXShaderCompiler, on the PATH or EOT_DXC) for the host shaders.
#
# Copyright (C) 2026 KongaTime
# SPDX-License-Identifier: MIT

set(EOT_SRC "$ENV{EDGEOFTIMERECOMP_SRC}")
if(NOT EOT_SRC)
	set(EOT_SRC ${ROOT}/../EdgeOfTimeRecomp)
endif()
get_filename_component(EOT_SRC "${EOT_SRC}" ABSOLUTE)
set(eot_plume ${EOT_SRC}/thirdparty/plume)
if(NOT EXISTS ${eot_plume}/contrib/volk/volk.h)
	message(FATAL_ERROR "No plume with its submodules at ${eot_plume}: git -C ${EOT_SRC} submodule update "
		"--init --recursive")
endif()
file(READ ${eot_plume}/plume_vulkan.cpp eot_plume_source)
if(NOT eot_plume_source MATCHES "createProsperoDisplaySurface")
	message(FATAL_ERROR "plume at ${eot_plume} has no PS5 support: git -C ${eot_plume} apply "
		"${EOT_SRC}/ps5/patches/plume-ps5.patch")
endif()
find_program(EOT_DXC dxc REQUIRED)
include(${EOT_SRC}/ps5/reeot-sources.cmake)

# The results file the game's players already know
set(TITLE_RESULTS_FILE /app0/reeot-test-results.txt)

set(eot_gen ${CMAKE_BINARY_DIR}/eot_gen)
file(MAKE_DIRECTORY ${eot_gen}/core ${eot_gen}/installer ${eot_gen}/shaders)

# --- The renderer: plume ------------------------------------------------------

add_library(eot_plume OBJECT ${eot_plume}/plume_vulkan.cpp)
target_include_directories(eot_plume PRIVATE ${eot_plume} ${eot_plume}/contrib/volk
	${eot_plume}/contrib/Vulkan-Headers/include ${eot_plume}/contrib/VulkanMemoryAllocator/include)
target_compile_definitions(eot_plume PRIVATE PLUME_NO_VOLK_IMPLEMENTATION NDEBUG)
target_compile_options(eot_plume PRIVATE -std=c++20 -O2 -fno-omit-frame-pointer)
rex_ps5_link_objects(eot_plume)

# --- Generated sources and headers --------------------------------------------

# core/build_info.h: the game repository's version and commit, the PS5 as the platform
file(READ ${EOT_SRC}/CMakeLists.txt eot_cmakelists)
string(REGEX MATCH "project\\(reeot VERSION ([0-9.]+)" _ "${eot_cmakelists}")
set(reeot_VERSION ${CMAKE_MATCH_1})
execute_process(COMMAND git -C ${EOT_SRC} rev-parse --short=9 HEAD
	OUTPUT_VARIABLE REEOT_GIT_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C ${EOT_SRC} rev-parse --abbrev-ref HEAD
	OUTPUT_VARIABLE REEOT_GIT_BRANCH OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C ${EOT_SRC} status --porcelain --untracked-files=no
	OUTPUT_VARIABLE eot_git_status ERROR_QUIET)
set(REEOT_GIT_DIRTY 0)
if(eot_git_status)
	set(REEOT_GIT_DIRTY 1)
endif()
set(REEOT_BUILD_PLATFORM ps5-amd64)
set(REEOT_BUILD_COMPILER "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
string(TIMESTAMP REEOT_BUILD_TIMESTAMP "%Y%m%d_%H%M")
configure_file(${EOT_SRC}/cmake/build_info.h.in ${eot_gen}/core/build_info.h @ONLY)

# embedded.h and its sources: res/embed, as the desktop build embeds it
include(${EOT_SRC}/cmake/embed.cmake)
reeot_embed_directory(ROOT ${EOT_SRC}/res/embed HEADER ${eot_gen}/embedded.h SOURCES_VAR eot_embed_sources)

# The port's packages, empty: the game folder from a PC install holds them
set(eot_packages_cpp "// Generated by games/edgeoftime/game.cmake - do not edit.\n#include <cstddef>\n#include <cstdint>\n")
foreach(package embedded_package:EmbeddedPortPackage:pkz/ReeotUI.pkz
		embedded_menu_package:EmbeddedMenuPackage:pkz/ReeotMenu.pkz
		embedded_achievements_package:EmbeddedAchievementsPackage:pkz/ReeotAchievements.pkz
		embedded_icons_package:EmbeddedIconsPackage:pkz/ReeotIcons.pkz
		embedded_suits_package:EmbeddedSuitsPackage:pkz/ReeotSuits.pkz)
	string(REPLACE ":" ";" parts ${package})
	list(GET parts 0 header)
	list(GET parts 1 accessor)
	list(GET parts 2 name)
	string(REGEX REPLACE "[^A-Za-z0-9]" "_" symbol "eot_embed_${name}")
	file(CONFIGURE OUTPUT ${eot_gen}/${header}.h CONTENT "// Generated by games/edgeoftime/game.cmake - do not edit.
#pragma once

#include <cstddef>
#include <cstdint>

#include \"embedded.h\"

extern const uint8_t ${symbol}[];
extern const size_t ${symbol}_size;

namespace eot {

// ${name}: not embedded in the PS5 title (the game folder holds it).
inline EmbeddedAsset ${accessor}() { return {\"${name}\", ${symbol}, ${symbol}_size}; }

} // namespace eot
")
	string(APPEND eot_packages_cpp "extern const uint8_t ${symbol}[] = {0};\nextern const size_t ${symbol}_size = 0;\n")
endforeach()
file(CONFIGURE OUTPUT ${eot_gen}/reeot_packages.cpp CONTENT "${eot_packages_cpp}")

# installer/program_files.h: what the title is made of
file(CONFIGURE OUTPUT ${eot_gen}/installer/program_files.h CONTENT "// Generated by games/edgeoftime/game.cmake - do not edit.
#pragma once

inline constexpr const char *kProgramFiles[] = {
    \"eboot.bin\",
};
")

# The HUD aspect policy
add_custom_command(OUTPUT ${eot_gen}/hud_aspect_policy.inc
	COMMAND ${Python3_EXECUTABLE} ${EOT_SRC}/tools/hud/gen_hud_policy.py
		${EOT_SRC}/config/eot_hud_aspect.toml ${eot_gen}/hud_aspect_policy.inc
	DEPENDS ${EOT_SRC}/config/eot_hud_aspect.toml ${EOT_SRC}/tools/hud/gen_hud_policy.py
	COMMENT "Edge of Time: the HUD aspect policy" VERBATIM)

# The host shaders, as SPIR-V (cmake/host_shaders.cmake's Vulkan settings)
set(eot_hlsl ${EOT_SRC}/src/gpu/shaders/hlsl)
file(GLOB eot_hlsli ${eot_hlsl}/*.hlsli)
set(eot_shader_headers)
foreach(shader ${REEOT_PS5_HOST_SHADERS})
	string(REPLACE ":" ";" parts ${shader})
	list(GET parts 0 stem)
	list(GET parts 1 profile)
	set(arguments -spirv -fvk-use-dx-layout)
	if(profile MATCHES "^vs")
		list(APPEND arguments -fvk-invert-y)
	endif()
	set(header ${eot_gen}/shaders/${stem}.hlsl.spirv.h)
	add_custom_command(OUTPUT ${header}
		COMMAND ${EOT_DXC} -T ${profile} -HV 2021 -all-resources-bound -Wno-ignored-attributes ${arguments}
			-I ${eot_hlsl} -Fh ${header} ${eot_hlsl}/${stem}.hlsl -Vn g_${stem}_spirv
		DEPENDS ${eot_hlsl}/${stem}.hlsl ${eot_hlsli}
		COMMENT "Edge of Time: host shader ${stem}.hlsl (${profile}, SPIR-V)" VERBATIM)
	list(APPEND eot_shader_headers ${header})
endforeach()

# The game's shaders, when the recompiled cache is there: split
# (ps5/tools/split-shader-cache.py), its compressed SPIR-V a file beside
# eboot.bin, shader-cache.zst; or whole, linked in
if(EXISTS ${EOT_SRC}/generated/shader_cache_ps5.cpp)
	set(eot_shader_cache ${EOT_SRC}/generated/shader_cache_ps5.cpp)
	message(STATUS "Edge of Time: the game's shaders from ${eot_shader_cache}, with "
		"${EOT_SRC}/generated/shader-cache.zst beside eboot.bin")
elseif(EXISTS ${EOT_SRC}/generated/shader_cache.cpp)
	set(eot_shader_cache ${EOT_SRC}/generated/shader_cache.cpp)
	message(STATUS "Edge of Time: the game's shaders from ${eot_shader_cache}")
else()
	set(eot_shader_cache ${EOT_SRC}/src/gpu/shaders/shader_cache_empty.cpp)
	message(STATUS "Edge of Time: no recompiled shaders yet, so the first launch finds them "
		"(shader-dump.bin) and closes")
endif()
add_library(eot_shader_cache OBJECT ${eot_shader_cache})
target_include_directories(eot_shader_cache PRIVATE ${EOT_SRC}/src/gpu/shaders)
target_compile_options(eot_shader_cache PRIVATE -O0 -w)
rex_ps5_link_objects(eot_shader_cache)

# --- The game's recompiled code -----------------------------------------------

set(eot_code_includes ${EOT_SRC} ${EOT_SRC}/src ${eot_gen})
rex_ps5_module(eot_recomp GENERATED ${EOT_SRC}/generated/default INCLUDES ${eot_code_includes})
list(TRANSFORM REEOT_PS5_GAMELOGIC_SOURCES PREPEND ${EOT_SRC}/)
rex_ps5_module(eot_gamelogic GENERATED ${EOT_SRC}/generated/gamelogic PREFIX reeot_GameLogic_
	SOURCES ${REEOT_PS5_GAMELOGIC_SOURCES} INCLUDES ${eot_code_includes})

# --- zstd ---------------------------------------------------------------------

set(eot_zstd ${EOT_SRC}/thirdparty/XenosRecomp/thirdparty/zstd/lib)
file(GLOB eot_zstd_sources ${eot_zstd}/common/*.c ${eot_zstd}/compress/*.c ${eot_zstd}/decompress/*.c)
add_library(eot_zstd OBJECT ${eot_zstd_sources})
target_include_directories(eot_zstd PRIVATE ${eot_zstd} ${eot_zstd}/common)
# ZSTD_TRACE=0: its trace hooks are weak references, which a title may not import
target_compile_definitions(eot_zstd PRIVATE ZSTD_DISABLE_ASM ZSTD_TRACE=0 XXH_NAMESPACE=ZSTD_)
target_compile_options(eot_zstd PRIVATE -O2 -fno-omit-frame-pointer -ffunction-sections -fdata-sections)
rex_ps5_link_objects(eot_zstd)

# --- The game repository's own sources ----------------------------------------

list(TRANSFORM REEOT_PS5_SOURCES PREPEND ${EOT_SRC}/)
add_library(eot_game OBJECT ${REEOT_PS5_SOURCES} ${eot_embed_sources} ${eot_gen}/reeot_packages.cpp
	${eot_gen}/hud_aspect_policy.inc ${eot_shader_headers}
	${EOT_SRC}/thirdparty/XenosRecomp/thirdparty/smol-v/source/smolv.cpp ${TITLE_DIR}/module_static.cpp
	${REX_APP_SOURCE})
# The shader dump a build with no shaders runs (src/gpu/shaders/shader_dump.cpp)
# reads the packs with PKZLib; its inflate is the zlib RADV's archive carries
set_source_files_properties(${EOT_SRC}/src/gpu/shaders/shader_dump.cpp PROPERTIES INCLUDE_DIRECTORIES
	"${EOT_SRC}/thirdparty/PKZLib;${EOT_SRC}/thirdparty/PKZLib/contrib/zlib")
target_include_directories(eot_game PRIVATE ${EOT_SRC}/src ${EOT_SRC} ${eot_gen}
	${EOT_SRC}/thirdparty/stb ${EOT_SRC}/thirdparty/XenosRecomp/XenosRecomp ${EOT_SRC}/thirdparty/renderdoc
	${EOT_SRC}/thirdparty/XenosRecomp/thirdparty/smol-v/source ${EOT_SRC}/generated/default
	${eot_plume} ${eot_plume}/contrib/volk ${eot_plume}/contrib/Vulkan-Headers/include
	${eot_plume}/contrib/VulkanMemoryAllocator/include ${eot_zstd})
rex_ps5_settings(eot_game)
target_compile_definitions(eot_game PRIVATE _ITERATOR_DEBUG_LEVEL=0 NOMINMAX WIN32_LEAN_AND_MEAN
	PLUME_NO_VOLK_IMPLEMENTATION)
rex_ps5_link_objects(eot_game)
