# PS5 ReXGlue Template - the ReXGlue runtime, and what a game builds with.
#
# The runtime is the ReXGlue fork with the PS5 target (../rexglue-sdk, or
# REXGLUE_SRC), built for the console by tools/build-rexglue.sh into the fork's
# out/ps5-amd64/ (its build folder build/rexglue, or REXGLUE_PS5_BUILD). Its
# archives are linked whole into the title with the SDK's libc++experimental.
#
# For a game's game.cmake:
#
#   rex_ps5_settings(<target>)
#       the runtime's headers, defines and language settings, as every part of
#       a ReXGlue game builds with them
#   rex_ps5_module(<target> GENERATED <dir> [PCH <header>] [PREFIX <prefix>]
#                  [SOURCES <file>...] [INCLUDES <dir>...])
#       recompiled code, from `rexglue codegen`'s output folder (its
#       sources.cmake). The game's executable needs nothing more. A module the
#       PC build opens as a shared library (a DLL the game loads) takes PREFIX:
#       its objects become one, with its names given the prefix
#       (tools/prelink_module.py), and the game registers its entry points
#       (games/edgeoftime/module_static.cpp shows how)
#   rex_ps5_link_objects(<target>...)
#       an object library's objects into the title
#   REX_APP_SOURCE
#       ReXApp's source, which a ReXGlue game builds as part of itself
#
# Copyright (C) 2026 KongaTime
# SPDX-License-Identifier: MIT

set(REXGLUE_SRC "$ENV{REXGLUE_SRC}")
if(NOT REXGLUE_SRC)
	set(REXGLUE_SRC ${ROOT}/../rexglue-sdk)
endif()
get_filename_component(REXGLUE_SRC "${REXGLUE_SRC}" ABSOLUTE)
set(REXGLUE_PS5_BUILD "$ENV{REXGLUE_PS5_BUILD}")
if(NOT REXGLUE_PS5_BUILD)
	set(REXGLUE_PS5_BUILD ${ROOT}/build/rexglue)
endif()
get_filename_component(REXGLUE_PS5_BUILD "${REXGLUE_PS5_BUILD}" ABSOLUTE)
set(rex_runtime_dir ${REXGLUE_SRC}/out/ps5-amd64)
if(NOT EXISTS ${rex_runtime_dir}/librexruntime.a OR NOT EXISTS ${REXGLUE_PS5_BUILD}/include/rex/version.h)
	message(FATAL_ERROR "No ReXGlue runtime built for the PS5 at ${rex_runtime_dir} (build folder "
		"${REXGLUE_PS5_BUILD}): run tools/build-rexglue.sh, or set REXGLUE_SRC and REXGLUE_PS5_BUILD")
endif()
message(STATUS "ReXGlue: the runtime from ${rex_runtime_dir}")
set(REX_APP_SOURCE ${REXGLUE_SRC}/src/ui/rex_app.cpp)

# The runtime's headers and settings, which every part of a game builds with
set(REX_INCLUDES ${REXGLUE_SRC}/include ${REXGLUE_PS5_BUILD}/include
	${REXGLUE_SRC}/thirdparty/fmt/include ${REXGLUE_SRC}/thirdparty/spdlog/include
	${REXGLUE_SRC}/thirdparty/simde ${REXGLUE_SRC}/thirdparty/simde/simde
	${REXGLUE_SRC}/thirdparty/utfcpp/source ${REXGLUE_SRC}/thirdparty/imgui
	${REXGLUE_SRC}/thirdparty/tomlplusplus/include ${REXGLUE_SRC}/thirdparty/xxHash)
set(REX_DEFINITIONS SPDLOG_COMPILED_LIB SPDLOG_FMT_EXTERNAL REX_HAS_VULKAN=1 REXGLUE_BUILD_CONFIG="Release" NDEBUG)
set(REX_OPTIONS -std=c++23 -fexperimental-library -fno-strict-aliasing -march=znver2
	-fno-omit-frame-pointer -ffunction-sections -fdata-sections)

function(rex_ps5_settings)
	foreach(target ${ARGN})
		target_include_directories(${target} PRIVATE ${REX_INCLUDES})
		target_compile_definitions(${target} PRIVATE ${REX_DEFINITIONS})
		target_compile_options(${target} PRIVATE ${REX_OPTIONS} -O2)
	endforeach()
endfunction()

# The link takes the object files as well as their targets: a target alone
# orders the link after it but does not relink when only its objects changed.
# A target's objects include its precompiled header's (.pch), which no link takes.
function(rex_ps5_link_objects)
	foreach(target ${ARGN})
		set(objects "$<FILTER:$<TARGET_OBJECTS:${target}>,INCLUDE,\\.o$>")
		set_property(GLOBAL APPEND PROPERTY TITLE_LINK_INPUTS ${objects})
		set_property(GLOBAL APPEND PROPERTY TITLE_LINK_DEPENDS ${target} ${objects})
	endforeach()
endfunction()

function(rex_ps5_module target)
	cmake_parse_arguments(PARSE_ARGV 1 arg "" "GENERATED;PCH;PREFIX" "SOURCES;INCLUDES")
	get_filename_component(generated "${arg_GENERATED}" ABSOLUTE)
	if(NOT EXISTS ${generated}/sources.cmake)
		message(FATAL_ERROR "No recompiled code at ${generated}: run `rexglue codegen` on the game's manifest "
			"first, with the game's files from your own copy")
	endif()
	set(pch "${arg_PCH}")
	if(NOT pch)
		file(GLOB pch ${generated}/*_pch.h)
		list(GET pch 0 pch)
	endif()
	# The PS5 maps memory at 64 KiB granularity, so the runtime maps the guest's
	# 0xE0000000 range without its 4 KiB offset and the code must add it, as on
	# Windows (rex::memory::detail::PhysicalHostOffset). The fork's codegen
	# template says so for the PS5; code generated by an upstream rexglue does
	# not, and every access above 0xE0000000 then misses by 4 KiB: such a header
	# is given the PS5 here.
	if(pch)
		file(READ ${pch} pch_text)
		if(pch_text MATCHES "REX_ARCH_ARM64\\)\n#define REX_PHYS_HOST_OFFSET")
			string(REPLACE "#if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && REX_ARCH_ARM64)\n#define REX_PHYS_HOST_OFFSET"
				"#if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && REX_ARCH_ARM64) || REX_PLATFORM_PS5\n#define REX_PHYS_HOST_OFFSET"
				pch_text "${pch_text}")
			file(WRITE ${pch} "${pch_text}")
			message(STATUS "ReXGlue: ${pch} given the PS5's 0xE0000000 offset")
		endif()
	endif()
	set(GENERATED_SOURCES)
	include(${generated}/sources.cmake)
	add_library(${target} OBJECT ${GENERATED_SOURCES} ${arg_SOURCES})
	target_include_directories(${target} PRIVATE ${arg_INCLUDES} ${generated} ${REX_INCLUDES})
	target_compile_definitions(${target} PRIVATE ${REX_DEFINITIONS})
	# As rexglue_apply_target_settings, at -O2 (the code is large)
	target_compile_options(${target} PRIVATE ${REX_OPTIONS} -O2 -mcmodel=large -msse4.1)
	if(pch)
		target_precompile_headers(${target} PRIVATE ${pch})
	endif()
	if(NOT arg_PREFIX)
		rex_ps5_link_objects(${target})
		return()
	endif()
	# A module the PC build opens as a shared library: its names stay its own
	set_target_properties(${target} PROPERTIES CXX_VISIBILITY_PRESET hidden)
	set(object ${CMAKE_BINARY_DIR}/${target}.o)
	set(objects "$<FILTER:$<TARGET_OBJECTS:${target}>,INCLUDE,\\.o$>")
	add_custom_command(OUTPUT ${object}
		COMMAND ${Python3_EXECUTABLE} ${ROOT}/tools/prelink_module.py --bin ${PS5_PAYLOAD_SDK}/bin
			--prefix ${arg_PREFIX} --out ${object} ${objects}
		DEPENDS ${target} ${objects} ${ROOT}/tools/prelink_module.py
		COMMAND_EXPAND_LISTS
		COMMENT "ReXGlue: ${target} as one object, its names prefixed ${arg_PREFIX}" VERBATIM)
	add_custom_target(${target}_object DEPENDS ${object})
	set_property(GLOBAL APPEND PROPERTY TITLE_LINK_INPUTS ${object})
	set_property(GLOBAL APPEND PROPERTY TITLE_LINK_DEPENDS ${target}_object ${object})
endfunction()
find_package(Python3 REQUIRED COMPONENTS Interpreter)

# The runtime and its libraries in one group (they refer to each other)
file(GLOB rex_runtime_archives ${rex_runtime_dir}/*.a)
list(REMOVE_ITEM rex_runtime_archives ${rex_runtime_dir}/librexruntime.a)

# libc names the runtime imports that no module a title loads exports (null at
# run time: link-title.sh refuses them), or that the console refuses a title,
# bound to the platform layer's: FFmpeg's isatty, libc++'s pathconf
# (std::filesystem), realpath, which std::filesystem's canonical paths are built
# on (EPERM to a title), and fork (a title starts no process). A game adds its
# own to TITLE_LIBC_BINDINGS in game.cmake.
set(TITLE_LIBC_BINDINGS isatty pathconf realpath fork)

# What the title links besides its objects, once game.cmake has run (the root
# CMakeLists.txt calls it): the runtime, the bindings and the abort wrap
function(rex_ps5_link_inputs inputs_var depends_var)
	set(bindings)
	set(names)
	foreach(name ${TITLE_LIBC_BINDINGS})
		list(APPEND bindings --defsym=${name}=ps5_${name})
		string(APPEND names "        ${name};\n")
	endforeach()
	# A bound name the SDK's stubs also define would be exported from the title
	# to override theirs, and the native tool refuses a title's exports: every
	# name bound here stays local, as PS5_Vulkan's recipe keeps its own
	set(map ${CMAKE_BINARY_DIR}/title-local.map)
	file(WRITE ${map} "{\n    local:\n${names}};\n")
	set(${inputs_var}
		--start-group ${rex_runtime_dir}/librexruntime.a ${rex_runtime_archives}
		${PS5_PAYLOAD_SDK}/target/lib/libc++experimental.a --end-group
		${bindings} --version-script ${map}
		# abort() through the runtime's fault records (its __wrap_abort)
		--wrap=abort PARENT_SCOPE)
	set(${depends_var} ${rex_runtime_dir}/librexruntime.a ${rex_runtime_archives} PARENT_SCOPE)
endfunction()
